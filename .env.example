# Server
PORT=8080
ENV=development

# Database
DATABASE_URL=postgres://ceche:secret@localhost:5432/ceche?sslmode=disable

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRY=15m
REFRESH_EXPIRY=168h

# Payments (Paystack)
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...

# Email (Brevo)
BREVO_API_KEY=...
BREVO_SENDER_EMAIL=noreply@ceche.net
BREVO_SENDER_NAME=Ceche

# CORS
CORS_ORIGINS=http://localhost:3000

# Encryption
DOMAIN_ENCRYPTION_KEY=change-me-to-32-byte-key!!!!

# Scanner
SCANNER_CONCURRENCY=50

# Rate Limiting
RATE_LIMIT_USER=100
RATE_LIMIT_API_KEY=1000
